{
  "name": "@pinarkive/pinarkive-sdk-ts",
  "version": "3.1.7",
  "description": "TypeScript SDK for the Pinarkive API v3 - fetch-based, Bearer auth, clusterId (cl) and timelock support. Replaces secureFetch/publicFetch in apps.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/index.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinarkive/pinarkive-sdk-ts.git"
  },
  "keywords": [
    "pinarkive",
    "api",
    "sdk",
    "typescript",
    "v3",
    "ipfs",
    "pinning",
    "cluster",
    "timelock"
  ],
  "author": "ITCS VIP",
  "publishConfig": {
    "access": "public"
  }
}
